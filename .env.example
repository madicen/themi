# Copy to .env and fill in. Never commit the real file.
# Real environment variables override values here.

# Fernet key that encrypts every stored credential. Generate with `themi keygen`.
# Back it up: without it, stored tokens and keys can't be decrypted.
THEMI_SECRET_KEY=
# ...or keep the key in a file instead:
# THEMI_SECRET_KEY_FILE=/run/secrets/themi.key

# Where the SQLite database lives.
THEMI_DB_PATH=data/themi.db

# Public HTTPS address of the website (Tailscale Funnel or similar), no trailing slash.
THEMI_PUBLIC_URL=

# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Another Bot API server. Only the local simulator uses it, and `make dev` sets it.
# TELEGRAM_API_URL=http://127.0.0.1:8090

# DEBUG, INFO, WARNING or ERROR.
THEMI_LOG_LEVEL=INFO

# Which tools each model call gets: "groups" (the core and the groups a message calls for),
# "all" (every tool; P5, to compare speed and accuracy) or "embeddings" (P7b: groups by
# meaning as well as by words, plus the groups used in the last few replies; needs Gemini).
# THEMI_TOOL_ROUTING=groups

# Conversation mode (CM1a-c): a plain chat reply, with tasks picked out in the background.
# "trial" (the default): /chat on turns it on for whoever asks, and only they see its switch
# on the website. "on": the switch is on everyone's settings. "off": not offered at all.
# THEMI_CONVERSATION_MODE=trial

# Where the website and /health listen. In Docker these are set for you.
THEMI_HTTP_HOST=127.0.0.1
THEMI_HTTP_PORT=8080

# Set to 1 to run without polling Telegram (smoke tests, diagnostics).
# THEMI_DISABLE_TELEGRAM=1

# Google sign-in and Gmail linking (see "Google Cloud setup" in the README).
# The OAuth client's redirect address must be <THEMI_PUBLIC_URL>/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# RC1a: Google's file picker, for choosing the family cookbook doc on Accounts (README:
# "The family cookbook"). A browser API key limited to the Picker API, and the project number.
# GOOGLE_PICKER_API_KEY=
# GOOGLE_PROJECT_NUMBER=

# The OurGroceries mirror of Themi's grocery list (optional). Themi's own list is
# the source of truth; OurGroceries just shows it. OURGROCERIES_LIST is the name of
# the shared list in the app (default "Groceries").
OURGROCERIES_USERNAME=
OURGROCERIES_PASSWORD=
# OURGROCERIES_LIST=Groceries

# The dishwasher, through Home Connect (Bosch, Siemens): register an app at
# developer.home-connect.com (Authorization Code Grant Flow; redirect URI
# <THEMI_PUBLIC_URL>/auth/home-connect/callback), then link it from the Family page.
# HOME_CONNECT_URL is only for the simulator (https://simulator.home-connect.com).
HOME_CONNECT_CLIENT_ID=
HOME_CONNECT_CLIENT_SECRET=
# HOME_CONNECT_URL=

# LG ThinQ (the washer and dryer, 30) needs nothing here: an admin pastes a personal
# access token (connect-pat.lgthinq.com) on the Family page. Pushes need the MQTT
# library (pip install 'themi[thinq]'); without it Themi reads the appliances every
# 5 minutes. THINQ_URL is only for pointing Themi at a fake.
# THINQ_URL=

# Cozyla (optional, experimental). Cozyla has no official API: this uses the one its
# tablet apps use, which may change or break, and may conflict with Cozyla's terms.
# Use the family's own Cozyla ID. `themi cozyla check` signs in and shows what's there,
# read-only. COZYLA_TODO_LIST is the main to-do list, where Themi's tasks go (the others
# are watched for items assigned to someone); leave it empty to turn the sync off. COZYLA_DEVICE_SN must stay the same once set.
COZYLA_EMAIL=
COZYLA_PASSWORD=
# COZYLA_TODO_LIST=
# COZYLA_DEVICE_SN=themi
# COZYLA_CHORES=yes lets Themi run the wall's chore chart: its chores are written there,
# chores only on the wall come into Themi first, and edits on the wall are put back.
# COZYLA_CHORES=

# Travel times to calendar events, with live traffic (optional). A free TomTom developer
# key (developer.tomtom.com; the free plan is plenty). Without it, Themi finds places on
# OpenStreetMap and makes a rough estimate from the distance. The home address is set on
# the website's Family page.
# TOMTOM_API_KEY=

# Looking things up online (optional, F30d). Tavily is the default: a free account at
# tavily.com gives 1,000 searches a month, no card needed. Firecrawl works instead
# (firecrawl.dev, 1,000 free credits a month, about 500 searches; no card). With both keys
# set, THEMI_SEARCH_BACKEND picks one (tavily or firecrawl). Without a key, Themi says it
# can't search yet.
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=
# THEMI_SEARCH_BACKEND=

# Nightly encrypted backups to S3-compatible storage (Cloudflare R2 or Backblaze B2);
# docs/DEPLOY.md section 7. All four go together. Backups are encrypted with
# THEMI_SECRET_KEY: keep that key in a password manager, or they can't be restored.
THEMI_BACKUP_ENDPOINT=
THEMI_BACKUP_BUCKET=
THEMI_BACKUP_ACCESS_KEY_ID=
THEMI_BACKUP_SECRET_ACCESS_KEY=
# THEMI_BACKUP_REGION=auto       # R2: auto. B2: the bucket's region, e.g. us-west-004
# THEMI_BACKUP_PREFIX=themi/
# THEMI_BACKUP_KEEP_DAYS=30

# On a server using deploy/compose.yml: the published image.
# THEMI_IMAGE=ghcr.io/madicen/themi
# THEMI_VERSION=latest
# THEMI_MEM_LIMIT=700m           # the container's memory cap; 1500m on a 4 GB+ Pi
# Updates from the website's Development page (docs/DEPLOY.md, section 9). compose.yml sets
# THEMI_CONTROL_DIR itself; control.sh on the host reads the two below.
# THEMI_GITHUB_TOKEN=            # fine-grained, Contents: read-only, to find the newest release
# THEMI_REPO=madicen/themi       # only if it isn't the one in THEMI_IMAGE
